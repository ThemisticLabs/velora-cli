<!doctype html><html lang="en"><meta charset="utf-8"><meta name="viewport" content="width=device-width"><meta http-equiv="Content-Security-Policy" content="default-src 'none'; img-src data:; style-src 'unsafe-inline'; script-src 'unsafe-inline'"><style>:root { color-scheme:dark;--bg:#171719;--surface:#282829;--ink:#f4f4f4;--muted:#99999c;--line:#444446;--accent:#686be7;--button:#eeeef0;--button-ink:#202021;--hover:#ffffff09 }
* { box-sizing:border-box }
body { margin:0;background:var(--bg);color:var(--ink);font:14px/1.4 -apple-system,BlinkMacSystemFont,"Helvetica Neue",sans-serif }
p { color:var(--muted);margin:0;font-size:13px }
.popover { position:relative;background:var(--surface);border:1px solid var(--line);border-radius:20px;padding:24px;width:332px;height:338px;box-shadow:0 12px 40px #0005, inset 0 1px 0 #ffffff0a }
.brand { display:flex;align-items:center;gap:10px;font-size:18px;font-weight:600;letter-spacing:-.02em }
.brand a { display:flex;border-radius:4px }
.brand img { width:23px;height:19px;object-fit:contain }
.status { margin-top:27px;margin-bottom:24px }
.state { font-size:15px;font-weight:500 }
.status p { font-size:12px;margin-top:5px;min-height:17px }
button { font:inherit;cursor:pointer }
button:focus-visible,a:focus-visible { outline:2px solid var(--accent);outline-offset:4px }
.primary { width:100%;height:43px;background:var(--button);color:var(--button-ink);border:0;border-radius:8px;font-weight:500 }
.primary:hover { opacity:.9 }
.primary:disabled { opacity:.5;cursor:default }
.divider { height:1px;background:var(--line);margin:21px 0 8px }
.actions { display:grid;gap:1px }
.action { display:flex;align-items:center;justify-content:space-between;width:100%;height:35px;border:0;background:transparent;color:var(--ink);padding:0 2px;text-align:left;border-radius:5px }
.action:hover { background:var(--hover) }
.action img { width:17px;height:17px;filter:invert(1);opacity:.65 }
.popover { width:100%;max-width:332px }
body { padding:0;background:transparent;min-height:0 }
.popover { margin:0;width:332px;height:338px;border:0;border-radius:0;box-shadow:none }
.state { gap:0 }
#detail { height:38px;overflow:hidden }
</style><body><section class="popover" aria-label="velora service controls"><div class="brand"><a href="https://themistic.com" target="_blank" rel="noopener noreferrer" aria-label="Open Themistic website"><img src="data:image/svg+xml;base64,PHN2ZyB4bWxucz0iaHR0cDovL3d3dy53My5vcmcvMjAwMC9zdmciIHZpZXdCb3g9IjQwIDQwIDQ0MCAzMjAiIGZpbGw9IiNmZmZmZmYiIGFyaWEtaGlkZGVuPSJ0cnVlIj48cGF0aCBkPSJNNDAgNDBIMzMwTDI2MCAxMTBIMTkwVjI3MEwxMjAgMzQwVjExMEg0MFoiLz48cGF0aCBkPSJNMzEwIDkwSDQ4MFYxNjBIMzAwVjI5MEg0ODBWMzYwSDIzMFYxNzBaIi8+PC9zdmc+Cg==" alt="Themistic"></a><span>velora</span></div><div class="status"><div class="state"><span id="state-label">Running</span></div><p id="detail">Local API ready.</p></div><button class="primary" id="service">Stop service</button><div class="divider"></div><div class="actions"><button class="action" id="open"><span>Open velora</span><img src="data:image/svg+xml;base64," alt=""></button><button class="action" id="settings"><span>Settings</span><img src="data:image/svg+xml;base64," alt=""></button></div></section><script>
var state = 'stopped';
for (var name of ['service', 'open', 'settings']) {
    document.getElementById(name).addEventListener('click', function () {
        window.webkit.messageHandlers.velora.postMessage(this.id);
    });
}
document.querySelector('.brand a').addEventListener('click', function (event) {
    event.preventDefault();
    window.webkit.messageHandlers.velora.postMessage('website');
});
function renderStatus(status) {
    state = status.state;
    var label = 'Stopped';
    var detail = 'The local API is not running.';
    var action = 'Start service';
    if (state === 'running') { label = 'Running'; detail = 'Local API ready.'; action = 'Stop service'; }
    if (state === 'starting') { label = 'Starting'; detail = 'Loading the selected model…'; action = 'Stop service'; }
    if (state === 'stopping') { label = 'Stopping'; detail = 'Finishing the active request…'; action = 'Stopping…'; }
    if (state === 'failed') { label = 'Service unavailable'; detail = status.message; action = 'Stop service'; }
    if (status.message) { detail = status.message; }
    document.getElementById('state-label').textContent = label;
    document.getElementById('detail').textContent = detail;
    document.getElementById('detail').title = detail;
    document.getElementById('service').textContent = action;
    document.getElementById('service').disabled = status.busy || state === 'stopping';
}
renderStatus({state: 'stopped'});
</script><!-- Gallery Lucide icon license: ISC License

